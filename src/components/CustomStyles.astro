<style is:inline>
  :root {
    --aw-font-sans: 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
    --aw-font-serif: var(--aw-font-sans);
    --aw-font-heading: var(--aw-font-sans);
    --aw-color-primary: rgb(18 47 83);
    --aw-color-secondary: rgb(33 72 117);
    --aw-color-accent: rgb(224 83 32);
    --aw-color-text-heading: rgb(18 47 83);
    --aw-color-text-default: rgb(42 57 76);
    --aw-color-text-muted: rgb(93 106 121);
    --aw-color-bg-page: rgb(255 250 241);
    --aw-color-bg-page-dark: rgb(15 25 42);
    --club-orange: #c94b1e;
    --club-surface: #fffdf7;
    --club-line: #122f5324;
    --club-grid: #122f5307;
    --club-shadow: #122f530d;
  }
  .dark {
    --aw-color-primary: rgb(255 190 135);
    --aw-color-secondary: rgb(255 213 175);
    --aw-color-text-heading: rgb(255 245 230);
    --aw-color-text-default: rgb(228 234 242);
    --aw-color-text-muted: rgb(172 187 207);
    --aw-color-bg-page: rgb(15 25 42);
    --club-orange: #ffb15d;
    --club-surface: #192b44;
    --club-line: #d3e1f12e;
    --club-grid: #d3e1f109;
    --club-shadow: #00000026;
  }
  ::selection {
    background: #ffc98c;
    color: #122f53;
  }
  :focus-visible {
    outline: 3px solid var(--aw-color-primary);
    outline-offset: 4px;
  }
  [id] {
    scroll-margin-top: 6rem;
  }
</style>
