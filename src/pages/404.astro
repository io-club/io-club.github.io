---
import Layout from '~/layouts/PageLayout.astro';
import { getHomePermalink } from '~/utils/permalinks';
---

<Layout metadata={{ title: '页面未找到', robots: { index: false, follow: true } }}>
  <section class="mx-auto max-w-2xl px-6 py-24 text-center">
    <p class="mb-8 text-8xl font-bold text-primary">404</p>
    <h1 class="text-3xl font-bold">这个页面还没有找到</h1>
    <p class="my-6 text-lg text-muted">可能是链接发生了变化。回到首页，继续认识 IO Club 吧。</p>
    <a href={getHomePermalink()} class="btn-primary">返回首页</a>
  </section>
</Layout>
